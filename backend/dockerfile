# -------------------
# Build Stage for Go
# -------------------
FROM golang:1.23 AS builder

WORKDIR /app
        
# Copy Go module files and download dependencies
COPY go.mod go.sum ./
RUN go mod download
    
# Install Air for live reloading
RUN go install github.com/air-verse/air@latest
    
# --------------------
# Runtime Stage for Go
# --------------------
FROM golang:1.23-alpine
    
WORKDIR /app
    
# Install required dependencies
RUN apk add --no-cache libc6-compat git
    
# Copy Go dependencies from builder
COPY --from=builder /go/pkg/mod /go/pkg/mod
COPY go.mod go.sum ./
    
# Copy source code
COPY . .
    
# Copy Air from the builder stage
COPY --from=builder /go/bin/air /usr/local/bin/air 
    
# Ensure Air binary is executable
RUN chmod +x /usr/local/bin/air
    
# Copy Air config file if available
COPY .air.toml /app/
    
# Expose port
EXPOSE 8080
    
# Air command to run your server automatically from ./server/main.go
CMD ["air", "-c", ".air.toml"]
    
