# -----------------------------
# Public environment variables
# -----------------------------

# PostgreSQL settings
POSTGRES_HOST=localhost
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=postgre_db
POSTGRES_PORT=5432

# Go Backend settings
GO_ENV=dev
PORT=8080
LOG_LEVEL=debug
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=24h
ENABLE_AUTH=false
DATABASE_URL=postgres://your_username:your_password@db:5432/restaurant_db?sslmode=disable

# Flutter Frontend variables
FLUTTER_ENV=dev

# Other settings as needed...
